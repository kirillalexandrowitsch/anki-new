    "Здесь появятся задания на сегодня после подключения коллекции.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся задания на сегодня после подключения коллекции."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks for today will appear here once a collection is connected."
          }
        }
      }
    },
    "Здесь будут ваши колоды и материалы для повторения.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
